#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# check-recipe -- the Arch recipe (PKGBUILD) of a consuming repository builds
# THAT repository's signed release tag and says true things about it.
#
# Usage: check-recipe [--root DIR] [--repo NAME] [--recipe PATH] [--keys PATH]
#                     [--srcname NAME] [--pin VAR=CMAKEFILE]...
#                     [--p11kit-option CMAKE_OPTION]
#
#   own     exactly one source is this repository's own, spelled
#           [<local>::]git+https://github.com/LibreSCRS/<repo>.git#tag=$pkgver?signed
#           No GitHub archive/refs/tags tarball (bytes nobody signs), no
#           release-asset tarball (its sum cannot exist before the tag), no
#           sibling repository (the recipes were near-copies), no v-prefix, no
#           branch or missing ref, no tag without ?signed. --srcname also fixes
#           the local name (build() cds into it).
#   version pkgver equals the first line of VERSION.
#   pins    every submodule gitlink of the index appears verbatim in the recipe;
#           each --pin VAR=FILE: the recipe's VAR=<40-hex> equals the one
#           `GIT_TAG <40-hex>` in FILE (the FetchContent module the build would
#           otherwise fetch with -- two copies of one fact drift silently).
#   trust   validpgpkeys is exactly the set of primary fingerprints in KEYS;
#           a VCS source's sum is SKIP (makepkg refuses one; the signature is
#           the check); every other source, an upstream archive at a fixed
#           commit, carries a real 64-hex sha256. Same answer before and after
#           the tag.
#   p11kit  with --p11kit-option OPT: unless build() passes -DOPT=ON, neither
#           the recipe nor the README beside it names share/p11-kit/modules and
#           optdepends does not offer p11-kit (a package once described a
#           registration it did not install).
#
# The recipe is read as TEXT, never sourced: it guards the honest edit of
# source=, pkgver or a pin, not a recipe written to mislead (a URL assembled
# from variables, source_x86_64=(), an array not opened at column 0).
#
# This lives in LibreSCRS/ci and is run as `bash check-recipe`, so the class
# of a repository-local copy losing its exec bit and stopping CI with 126
# before judging anything is gone by construction.
#
# Root: --root, else REPO_ROOT, else GITHUB_WORKSPACE, else the git top level of
# the working directory. Repository name: --repo, else the repository part of
# GITHUB_REPOSITORY, else the root's directory name.
#
# Exit codes: 0 green; 1 a rule failed; 2 cannot judge (no root, no recipe, no
# KEYS, no gpg, no primary key in KEYS, bad usage).
set -u

usage() { echo "usage: check-recipe [--root DIR] [--repo NAME] [--recipe PATH] [--keys PATH] [--srcname NAME] [--pin VAR=FILE]... [--p11kit-option OPT]" >&2; exit 2; }
ROOT="" REPO="" RECIPE="" KEYS="" SRCNAME="" P11OPT=""
PINS=()
while [ "$#" -gt 0 ]; do
  [ "$#" -ge 2 ] || usage
  case "$1" in
    --root) ROOT="$2" ;;
    --repo) REPO="$2" ;;
    --recipe) RECIPE="$2" ;;
    --keys) KEYS="$2" ;;
    --srcname) SRCNAME="$2" ;;
    --pin) case "$2" in *=?*) PINS+=("$2") ;; *) usage ;; esac ;;
    --p11kit-option) P11OPT="$2" ;;
    *) usage ;;
  esac
  shift 2
done

[ -n "$ROOT" ] || ROOT="${REPO_ROOT:-${GITHUB_WORKSPACE:-}}"
[ -n "$ROOT" ] || ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$ROOT" ] && [ -d "$ROOT" ] || { echo "check-recipe: no repository to judge -- set REPO_ROOT or pass --root" >&2; exit 2; }
ROOT="$(cd "$ROOT" && pwd)"
if [ -z "$REPO" ]; then REPO="${GITHUB_REPOSITORY:-}"; REPO="${REPO##*/}"; fi
[ -n "$REPO" ] || REPO="$(basename "$ROOT")"
case "$RECIPE" in '') RECIPE="$ROOT/packaging/arch/PKGBUILD" ;; /*) ;; *) RECIPE="$ROOT/$RECIPE" ;; esac
case "$KEYS" in '') KEYS="$ROOT/KEYS" ;; /*) ;; *) KEYS="$ROOT/$KEYS" ;; esac

rc=0
bad() { printf 'FAIL   %s\n' "$1"; rc=1; }
cannot() { printf 'FATAL  %s -- cannot judge\n' "$1" >&2; exit 2; }

[ -f "$RECIPE" ] || cannot "no recipe at $RECIPE"
[ -f "$KEYS" ] || cannot "no KEYS at $KEYS; validpgpkeys cannot be compared with anything"
command -v gpg >/dev/null 2>&1 || cannot "gpg is not on PATH; KEYS cannot be read"

# array <name>: the quoted entries of a column-0 `<name>=( ... )` array, one per
# line, one-line or multi-line. A `#` outside quotes starts a comment; inside
# quotes it is part of the entry (#tag=...).
array() {
  awk -v name="$1" '
    !on && index($0, name "=(") == 1 { on = 1; $0 = substr($0, length(name) + 3) }
    on {
      q = ""; cur = ""
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (q != "") { if (c == q) { print cur; cur = ""; q = "" } else cur = cur c; continue }
        if (c == "\"" || c == "\047") { q = c; continue }
        if (c == "#") break
        if (c == ")") { on = 0; exit }
      }
    }' "$RECIPE"
}

pkgver="$(sed -nE 's/^pkgver=([^[:space:]#]+).*/\1/p' "$RECIPE" | head -n 1)"
[ -n "$pkgver" ] || bad "version: no pkgver= in the recipe"

# --- own -------------------------------------------------------------------
# shellcheck disable=SC2016  # the recipe's literal $pkgver, not ours
tags=('tag=$pkgver' 'tag=${pkgver}')
base="git+https://github.com/LibreSCRS/$REPO.git#"
mapfile -t entries < <(array source)
n=${#entries[@]}
own=0
if ! grep -q '^source=(' "$RECIPE"; then
  bad "own: no 'source=(' at column 0 -- the pattern matches nothing, which is a vacuum and not a pass"
elif [ "$n" -eq 0 ]; then
  bad "own: the source=() array holds no entries"
fi
for e in "${entries[@]}"; do
  url="${e#*::}"
  case "$url" in
    *archive/refs/tags*) bad "own: fetches GitHub's auto-generated archive, whose bytes nobody signs: $url"; continue ;;
    *releases/download/*) bad "own: fetches a release asset, whose sum cannot exist before the tag -- build the signed tag: $url"; continue ;;
  esac
  case "$url" in *github.com/LibreSCRS/*) ;; *) continue ;; esac
  rest="${url#*github.com/LibreSCRS/}"
  erepo="${rest%%[/.#?]*}"
  if [ "$erepo" != "$REPO" ]; then
    bad "own: fetches LibreSCRS/$erepo while this repository is $REPO -- a recipe copied from a sibling builds the sibling"
    continue
  fi
  own=$((own + 1))
  ref=""
  case "$url" in *'#'*) ref="${url#*#}"; ref="${ref%%\?*}" ;; esac
  if [ "$url" = "$base${tags[0]}?signed" ] || [ "$url" = "$base${tags[1]}?signed" ]; then
    :
  elif [ -z "$ref" ]; then
    bad "own: names no ref, so makepkg builds whatever the default branch holds: $url"
  elif [ "${ref#tag=v}" != "$ref" ]; then
    bad "own: asks for a v-prefixed tag; every tag in this stack is unprefixed: $url"
  elif [ "$ref" != "${tags[0]}" ] && [ "$ref" != "${tags[1]}" ]; then
    bad "own: pinned to '$ref', not to the tag \$pkgver: $url"
  else
    case "$url" in
      *'?signed') bad "own: not spelled ${base}tag=\$pkgver?signed: $url" ;;
      *) bad "own: the tag is fetched without ?signed, so makepkg never checks its signature: $url" ;;
    esac
  fi
  if [ -n "$SRCNAME" ] && [ "${e%%::*}" != "$SRCNAME" ]; then
    bad "own: the local name is '$([ "$e" = "$url" ] || printf '%s' "${e%%::*}")', not '$SRCNAME' (build() enters that directory): $e"
  fi
done
printf 'own: %d source entr%s, %d of LibreSCRS/%s\n' "$n" "$([ "$n" -eq 1 ] && echo y || echo ies)" "$own" "$REPO"
[ "$n" -eq 0 ] || [ "$own" -eq 1 ] || bad "own: expected exactly one source of LibreSCRS/$REPO (its signed tag), found $own"

# --- version ---------------------------------------------------------------
vf="$ROOT/VERSION"
if [ ! -f "$vf" ]; then
  bad "version: $vf is missing -- pkgver cannot be shown to agree with anything"
else
  declared="$(sed -n '1p' "$vf" | tr -d '[:space:]')"; declared="${declared#v}"
  if [ -z "$declared" ]; then bad "version: the first line of VERSION is empty"
  elif [ -n "$pkgver" ] && [ "$declared" != "$pkgver" ]; then bad "version: VERSION says $declared, the recipe says pkgver=$pkgver"
  elif [ -n "$pkgver" ]; then printf 'version: pkgver=%s equals VERSION\n' "$pkgver"; fi
fi

# --- pins ------------------------------------------------------------------
# From the index, not HEAD: the gate judges the tree it is run over.
gl=0 ok=0
while read -r mode sha _ path; do
  [ "$mode" = 160000 ] || continue
  gl=$((gl + 1))
  if grep -q "$sha" "$RECIPE"; then ok=$((ok + 1))
  else bad "pins: submodule $path is at $sha, which appears nowhere in the recipe"; fi
done < <(git -C "$ROOT" ls-files -s 2>/dev/null)
printf 'pins: %d submodule gitlink(s), %d in the recipe\n' "$gl" "$ok"
for p in "${PINS[@]}"; do
  var="${p%%=*}" file="${p#*=}"
  case "$file" in /*) ;; *) file="$ROOT/$file" ;; esac
  rp="$(sed -nE "s/^${var}=['\"]?([0-9a-f]{40})['\"]?([[:space:]#].*)?\$/\\1/p" "$RECIPE" | head -n 1)"
  if [ -z "$rp" ]; then bad "pins: the recipe carries no ${var}=<40-hex>"; continue; fi
  [ -f "$file" ] || { bad "pins: ${var}=$rp but $file is missing -- nothing to keep it in lockstep with"; continue; }
  mapfile -t decl < <(sed -nE 's/^[[:space:]]*GIT_TAG[[:space:]]+([0-9a-f]{40})[[:space:]]*$/\1/p' "$file")
  if [ "${#decl[@]}" -ne 1 ]; then bad "pins: $file must hold exactly one 'GIT_TAG <40-hex>' line; found ${#decl[@]}"
  elif [ "${decl[0]}" != "$rp" ]; then bad "pins: ${var} drift -- $file says ${decl[0]}, the recipe says $rp"
  else printf 'pins: %s=%s matches %s\n' "$var" "$rp" "${file#"$ROOT"/}"; fi
done

# --- trust -----------------------------------------------------------------
gh="$(mktemp -d "${TMPDIR:-/var/tmp}/check-recipe-gpg.XXXXXX")" || cannot "no temporary directory"
mapfile -t want < <(GNUPGHOME="$gh" gpg --batch --show-keys --with-colons "$KEYS" 2>/dev/null \
  | awk -F: '$1 == "pub" {p = 1; next} p && $1 == "fpr" {print toupper($10); p = 0}' | sort -u)
rm -rf "$gh"
[ "${#want[@]}" -gt 0 ] || cannot "KEYS holds no primary key gpg can read"
mapfile -t have < <(array validpgpkeys | tr '[:lower:]' '[:upper:]' | sort -u)
if [ "${#have[@]}" -eq 0 ]; then
  bad "trust: no validpgpkeys -- ?signed then accepts a signature by any key makepkg trusts"
elif [ "${have[*]}" != "${want[*]}" ]; then
  bad "trust: validpgpkeys names ${have[*]}, but KEYS carries ${want[*]}"
else
  printf 'trust: validpgpkeys is the primary key set of KEYS (%s)\n' "${want[*]}"
fi
mapfile -t sums < <(array sha256sums)
if [ "${#sums[@]}" -eq 0 ]; then
  bad "trust: no sha256sums entries -- the pattern matches nothing, which is a vacuum and not a pass"
elif [ "${#sums[@]}" -ne "$n" ]; then
  bad "trust: ${#sums[@]} sha256sums for $n sources -- makepkg pairs them by position"
else
  nvcs=0 nreal=0
  for i in "${!entries[@]}"; do
    url="${entries[$i]#*::}" v="${sums[$i]}"
    case "$url" in
      git+*|svn+*|hg+*|bzr+*|fossil+*)
        nvcs=$((nvcs + 1))
        [ "$v" = SKIP ] || bad "trust: the VCS source $url carries '$v' -- makepkg refuses a sum there; the signature is the check" ;;
      *)
        if [[ "$v" =~ ^[0-9a-f]{64}$ ]]; then nreal=$((nreal + 1))
        else bad "trust: $url is a download at a fixed revision and carries '$v', not its sha256 -- its bytes exist, so the sum can be written now"; fi ;;
    esac
  done
  printf 'trust: %d VCS source(s) at SKIP, %d download(s) with a real sha256\n' "$nvcs" "$nreal"
fi

# --- p11kit ----------------------------------------------------------------
if [ -n "$P11OPT" ]; then
  if sed -n '/^build()/,/^}/p' "$RECIPE" | grep -q -- "-D${P11OPT}=ON"; then
    printf 'p11kit: build() installs the p11-kit registration; describing it is true\n'
  else
    claims=0
    for f in "$RECIPE" "$(dirname "$RECIPE")/README.md"; do
      [ -f "$f" ] || continue
      while IFS= read -r hit; do
        bad "p11kit: $(basename "$f"):${hit%%:*} names share/p11-kit/modules, which the package does not install (build() leaves $P11OPT off)"
        claims=$((claims + 1))
      done < <(grep -n 'share/p11-kit/modules' "$f")
    done
    if array optdepends | grep -q 'p11-kit'; then
      bad "p11kit: optdepends offers p11-kit, and the package installs no p11-kit registration"
      claims=$((claims + 1))
    fi
    [ "$claims" -ne 0 ] || printf 'p11kit: no registration installed, and none described\n'
  fi
fi

echo "check-recipe: $REPO $([ "$rc" -eq 0 ] && echo GREEN || echo RED)"
exit "$rc"
